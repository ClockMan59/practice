<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Калькулятор вкладов"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Сумма вклада (₽)"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etPercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Процентная ставка (%)"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etMonths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Срок (в месяцах)"
        android:inputType="number"
        android:textSize="18sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Рассчитать прибыль"
        android:textSize="18sp"
        android:padding="12dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Здесь будет твой профит 💰"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#4CAF50"/> </LinearLayout>